{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile with contact details, role, and activity timestamps",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "ward": { "type": "string" },
        "role": { "type": "string", "enum": ["citizen", "municipal_commissioner", "ward_officer", "field_engineer", "admin"] },
        "department": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "loginCount": { "type": "number" },
        "karmaScore": { "type": "number" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Civic grievance reported with location, category, severity, and status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "department": { "type": "string" },
        "ward": { "type": "string" },
        "landmark": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "photos": { "type": "array" },
        "citizenId": { "type": "string" },
        "citizenName": { "type": "string" },
        "citizenEmail": { "type": "string" },
        "citizenPhone": { "type": "string" },
        "submittedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "upvotes": { "type": "number" }
      },
      "required": ["id", "title", "category", "status", "ward"]
    },
    "InfrastructureProject": {
      "title": "InfrastructureProject",
      "description": "Public infrastructure development project with budget, progress, milestones, location, and delay tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "department": { "type": "string" },
        "contractor": { "type": "string" },
        "city": { "type": "string" },
        "zone": { "type": "string" },
        "constituency": { "type": "string" },
        "location": { "type": "string" },
        "ward": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "budget": { "type": "number" },
        "estimatedBudget": { "type": "number" },
        "sanctionedBudget": { "type": "number" },
        "releasedBudget": { "type": "number" },
        "utilizedBudget": { "type": "number" },
        "remainingBudget": { "type": "number" },
        "startDate": { "type": "string" },
        "expectedCompletionDate": { "type": "string" },
        "actualCompletionDate": { "type": "string" },
        "progressPercent": { "type": "number" },
        "status": { "type": "string" },
        "currentPhase": { "type": "string" },
        "delayStatus": { "type": "string" },
        "delayDays": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "department", "ward", "status", "progressPercent"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user accounts and profiles"
    },
    "/complaints/{complaintId}": {
      "schema": "Complaint",
      "description": "Real-time municipal complaints and grievances"
    },
    "/projects/{projectId}": {
      "schema": "InfrastructureProject",
      "description": "Public infrastructure projects and development milestones"
    },
    "/infrastructure_projects/{projectId}": {
      "schema": "InfrastructureProject",
      "description": "Public infrastructure projects and development milestones"
    }
  }
}
