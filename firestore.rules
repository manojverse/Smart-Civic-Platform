rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    function isCitizen() {
      return signedIn() && userRole(request.auth.uid) == 'citizen';
    }

    function isOfficer() {
      return signedIn() && (
        userRole(request.auth.uid) == 'officer' ||
        userRole(request.auth.uid) == 'staff'
      );
    }

    function isAdmin() {
      return signedIn() && userRole(request.auth.uid) == 'admin';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function complaintOwner(complaint) {
      return complaint.reportedBy != null && complaint.reportedBy.id == request.auth.uid;
    }

    function authorizedComplaintUpdate() {
      return signedIn() && (
        isAdmin() ||
        (isOfficer() && resource.data.assignedOfficer != null && resource.data.assignedOfficer.id == request.auth.uid) ||
        complaintOwner(resource.data)
      );
    }

    match /users/{userId} {
      allow get: if signedIn() && (isOwner(userId) || isOfficer() || isAdmin());
      allow list: if signedIn() && (isOfficer() || isAdmin());

      allow create: if signedIn() &&
        isOwner(userId) &&
        request.resource.data.id == request.auth.uid &&
        request.resource.data.role == 'citizen' &&
        request.resource.data.email == request.auth.token.email;

      allow update: if signedIn() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.role == resource.data.role)
      );

      allow delete: if signedIn() && isAdmin();
    }

    match /complaints/{complaintId} {
      allow create: if signedIn() &&
        request.resource.data.reportedBy != null &&
        request.resource.data.reportedBy.id == request.auth.uid &&
        request.resource.data.status == 'Submitted';

      allow get: if signedIn() && (
        isAdmin() ||
        isOfficer() ||
        complaintOwner(resource.data)
      );

      allow list: if signedIn() && (
        isAdmin() ||
        isOfficer() ||
        complaintOwner(resource.data)
      );

      allow update: if authorizedComplaintUpdate() &&
        request.resource.data.reportedBy.id == resource.data.reportedBy.id &&
        request.resource.data.status in ['Submitted', 'Verified', 'Assigned', 'In Progress', 'Resolved', 'Closed'];

      allow delete: if signedIn() && isAdmin();
    }

    match /projects/{projectId} {
      allow read: if signedIn() && (isCitizen() || isOfficer() || isAdmin());
      allow create, update, delete: if signedIn() && isAdmin();
    }

    match /infrastructure_projects/{projectId} {
      allow read: if signedIn() && (isCitizen() || isOfficer() || isAdmin());
      allow create, update, delete: if signedIn() && isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isOfficer() ||
        isAdmin()
      );
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isOfficer()
      );
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isOfficer()
      );
      allow delete: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
