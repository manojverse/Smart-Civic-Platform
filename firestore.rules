rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@smartcivic.test' ||
        request.auth.token.email == 'admin@civic' ||
        request.auth.token.email == 'manojs.n105@gmail.com'
      );
    }

    function isOfficer() {
      return isSignedIn() && (
        request.auth.token.email == 'officer@smartcivic.test' ||
        request.auth.token.email == 'officer@civic' ||
        isAdmin()
      );
    }

    function isComplaintOwner(complaintData) {
      return isSignedIn() && (
        (complaintData.reportedBy != null && complaintData.reportedBy.id == request.auth.uid) ||
        complaintData.citizenId == request.auth.uid
      );
    }

    // ─── USERS COLLECTION ──────────────────────────────────────────
    // Every authenticated user can access their own profile users/{uid}
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isOfficer()
      );

      allow list: if isSignedIn() && (isAdmin() || isOfficer());

      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ─── COMPLAINTS COLLECTION ─────────────────────────────────────
    match /complaints/{complaintId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isAdmin() ||
        isOfficer() ||
        isComplaintOwner(resource.data)
      );

      allow delete: if isAdmin();
    }

    // ─── INFRASTRUCTURE PROJECTS ───────────────────────────────────
    match /infrastructure_projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isAdmin() || isOfficer());
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isAdmin() || isOfficer());
    }

    // ─── DEPARTMENTS ───────────────────────────────────────────────
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ─── NOTIFICATIONS ─────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ─── ANNOUNCEMENTS ─────────────────────────────────────────────
    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isAdmin() || isOfficer());
    }

    // ─── AUDIT LOGS ────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Audit logs are immutable
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
