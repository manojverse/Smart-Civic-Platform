rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection: user profiles, live presence, and activity
    match /users/{userId} {
      allow read, write: if true;
    }

    // Complaints collection: public civic tracking, citizen reports, and authority updates
    match /complaints/{complaintId} {
      allow read, write: if true;
    }
  }
}
